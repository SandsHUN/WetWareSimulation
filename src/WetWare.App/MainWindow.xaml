<Window x:Class="WetWare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WetWare.App.Localization"
        xmlns:vm="clr-namespace:WetWare.App.ViewModels"
        xmlns:svc="clr-namespace:WetWare.App.Services"
        Title="WetWare Lab" Width="1600" Height="980" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico" Background="{StaticResource Bg0Brush}"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="ToolTip" Value="{Binding NavTip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="9" Height="42">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                        Background="{StaticResource AccentGradientBrush}" Opacity="0" Margin="1,0,0,0" />
                                <ContentPresenter Margin="13,0,10,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2Brush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Rectangle Fill="{StaticResource WindowGlowBrush}" IsHitTestVisible="False" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Title bar ============ -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/app.ico" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="WetWare Lab" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="15"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Margin="8,1,0,0" Padding="7,1,7,2" CornerRadius="6" VerticalAlignment="Center"
                            Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            ToolTip="{x:Static svc:AppInfo.Copyright}">
                        <TextBlock Text="{x:Static svc:AppInfo.VersionLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                    <TextBlock Text="{loc:Tr App.Tagline}" Foreground="{StaticResource TextFaintBrush}" FontSize="12.5"
                               Margin="12,1,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Style="{StaticResource SegmentHost}" VerticalAlignment="Center" Margin="0,0,14,0"
                            ToolTip="{loc:Tr Shell.Language.Tip}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentItem}" GroupName="Lang" IsChecked="{Binding IsHungarian, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xF2B7;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Magyar" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource SegmentItem}" GroupName="Lang" IsChecked="{Binding IsEnglish, Mode=TwoWay}" Content="English" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{loc:Tr Shell.Minimize}" />
                    <Button Style="{StaticResource CaptionButton}" x:Name="MaxButton" Content="&#xE922;" Click="Maximize_Click" ToolTip="{loc:Tr Shell.Maximize}" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{loc:Tr Shell.Close}" />
                </StackPanel>
            </DockPanel>

            <!-- ============ Body ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation rail -->
                <Border x:Name="Sidebar" Grid.Column="0" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,1,0" CornerRadius="0,14,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="236" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SidebarExpanded}" Value="False">
                                    <Setter Property="Width" Value="66" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel Margin="0,10,0,10">
                        <Button DockPanel.Dock="Top" Style="{StaticResource IconButton}" Content="&#xE700;" HorizontalAlignment="Left"
                                Margin="16,0,0,8" Background="Transparent" BorderBrush="Transparent"
                                Command="{Binding ToggleSidebarCommand}" ToolTip="{loc:Tr Shell.ToggleSidebar}" />

                        <Border DockPanel.Dock="Bottom" Margin="12,8,12,0" Padding="12" CornerRadius="12"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{loc:Tr Shell.ModelInfo.Tip}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Tr Shell.Engine}" Style="{StaticResource Caption}" Margin="7,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{loc:Tr Shell.ModelInfo}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" LineHeight="17" />
                                <TextBlock Text="{x:Static svc:AppInfo.FooterLabel}" Style="{StaticResource Caption}" Margin="0,8,0,0" FontWeight="Normal" />
                                <TextBlock Text="{x:Static svc:AppInfo.Copyright}" Style="{StaticResource Caption}" Margin="0,3,0,0" FontWeight="Normal" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" FontWeight="Normal" ToolTip="{loc:Tr Shell.License.Tip}">
                                    <Hyperlink NavigateUri="{x:Static svc:AppInfo.SourceUrl}" RequestNavigate="Hyperlink_RequestNavigate"
                                               Foreground="{StaticResource AccentBrush}" TextDecorations="{x:Null}">
                                        <Run Text="{loc:Tr Shell.License}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource NavListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PageViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="17" Width="22"
                                                   VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        <TextBlock Text="{Binding Title}" Margin="12,0,0,0" FontSize="13.5" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   Visibility="{Binding DataContext.SidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Page area -->
                <Grid Grid.Column="1" Margin="22,10,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="6,0,6,8">
                        <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding ShowGuide}" Margin="8,0,0,0"
                                      ToolTip="{loc:Tr Shell.Guide.Tip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE82D;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Tr Shell.Guide}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding ShowSimple}"
                                      ToolTip="{loc:Tr Shell.Simple.Tip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA80;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Tr Shell.Simple}" />
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource H1}" />
                            <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1">
                    <Border Margin="6,0,6,8" Padding="16,12" CornerRadius="12" BorderThickness="1"
                            BorderBrush="#40FBBF24" Background="#0FFBBF24"
                            Visibility="{Binding ShowSimple, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="#22FBBF24" VerticalAlignment="Top" Margin="0,0,14,0">
                                <TextBlock Text="&#xEA80;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarningBrush}" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentPage.SimpleTitle}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding CurrentPage.SimpleText}" Style="{StaticResource Body}" FontSize="13.5" LineHeight="21" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Margin="6,0,6,8" Padding="14,12" CornerRadius="12" BorderThickness="1"
                            BorderBrush="#3322D3EE" Background="#0D22D3EE"
                            Visibility="{Binding ShowGuide, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,14,0">
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" FontSize="15" />
                                <TextBlock Text="{loc:Tr Shell.TryThis}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding CurrentPage.GuideSteps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,22,4" MaxWidth="560">
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Top" Margin="0,4,6,0" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="13" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>

                    </StackPanel>

                    <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Focusable="False" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

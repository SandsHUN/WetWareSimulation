<UserControl x:Class="WetWare.App.Controls.MetricTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Margin="4">
    <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
            Padding="12,10" ToolTip="{Binding Tip, ElementName=Root}" Cursor="Help">
        <StackPanel>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph, ElementName=Root}" Style="{StaticResource Icon}" FontSize="12"
                           Foreground="{Binding Accent, ElementName=Root}" Margin="0,0,6,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxHeight="30"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding Value, ElementName=Root}" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                           FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="{Binding Unit, ElementName=Root}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Bottom" Margin="4,0,0,4" />
            </StackPanel>
            <ProgressBar Margin="0,6,0,0" Height="3" Maximum="1" Value="{Binding Level, ElementName=Root}"
                         Foreground="{Binding Accent, ElementName=Root}" />
        </StackPanel>
    </Border>
</UserControl>

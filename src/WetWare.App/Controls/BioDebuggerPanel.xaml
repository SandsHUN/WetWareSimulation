<UserControl x:Class="WetWare.App.Controls.BioDebuggerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WetWare.App.ViewModels"
             x:Name="Root">
    <ItemsControl ItemsSource="{Binding Lines, ElementName=Root}">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DebugLine}">
                <Border x:Name="Row" Margin="0,0,0,6" Padding="10,8" CornerRadius="9" Background="{StaticResource Bg1Brush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Num" Width="22" Height="22" CornerRadius="11" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Formula}" Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                            <TextBlock x:Name="Result" Text="{Binding Result}" Style="{StaticResource Mono}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Spike">
                        <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                        <Setter TargetName="Row" Property="Background" Value="#22F43F5E" />
                        <Setter TargetName="Result" Property="Foreground" Value="{StaticResource DangerBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Refractory">
                        <Setter TargetName="Result" Property="Foreground" Value="{StaticResource WarningBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>

<UserControl x:Class="WetWare.App.Controls.ParamSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WetWare.App.Controls"
             x:Name="Root" Margin="0,3,0,7">
    <StackPanel>
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" x:Name="ValueText" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label, ElementName=Root}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <c:InfoTip x:Name="Info" Margin="6,0,0,0" Text="{Binding Tip, ElementName=Root}" />
            </StackPanel>
        </DockPanel>
        <Slider x:Name="Slider" Margin="0,3,0,0"
                Minimum="{Binding Minimum, ElementName=Root}" Maximum="{Binding Maximum, ElementName=Root}"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
                SmallChange="{Binding Step, ElementName=Root}" LargeChange="{Binding Step, ElementName=Root}"
                TickFrequency="{Binding Step, ElementName=Root}" IsSnapToTickEnabled="{Binding Snap, ElementName=Root}" />
    </StackPanel>
</UserControl>

<UserControl x:Class="WetWare.App.Controls.InfoTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Cursor="Help" VerticalAlignment="Center">
    <Border x:Name="Circle" Width="17" Height="17" CornerRadius="9" BorderThickness="1"
            ToolTip="{Binding Text, ElementName=Root}" ToolTipService.InitialShowDelay="150">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock Text="i" FontFamily="Georgia" FontStyle="Italic" FontWeight="Bold" FontSize="11"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"
                   Foreground="{StaticResource TextMutedBrush}" />
    </Border>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Styles of the course companion (module pages, lessons, theory panel, quiz). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <LinearGradientBrush x:Key="CourseGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#22D3EE" />
        <GradientStop Offset="0.5" Color="#A78BFA" />
        <GradientStop Offset="1" Color="#F472B6" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CourseHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#16244A" />
        <GradientStop Offset="0.45" Color="#101833" />
        <GradientStop Offset="0.8" Color="#1E1440" />
        <GradientStop Offset="1" Color="#2A1238" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="FormulaBackBrush" Color="#0A1224" />
    <SolidColorBrush x:Key="FormulaTextBrush" Color="#D7F6FF" />
    <SolidColorBrush x:Key="Accent3Brush" Color="#F472B6" />

    <!-- ===================== Theory panel ===================== -->
    <Style x:Key="ConceptTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Reading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="LineHeight" Value="21.5" />
        <Setter Property="Foreground" Value="#C9D2E8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FormulaBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FormulaBackBrush}" />
        <Setter Property="BorderBrush" Value="#243358" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10,14,11" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="FormulaText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MathFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource FormulaTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Callout" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Small "example / preset" buttons used in every lab. -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <!-- ===================== Lesson stepper ===================== -->
    <Style x:Key="LessonStepItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Margin="0,0,8,0" Padding="12,8,14,8" CornerRadius="12" Background="#0BFFFFFF"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2Brush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Quiz ===================== -->
    <Style x:Key="QuizToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="11" Padding="13,10" Margin="0,0,0,7">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#0F34D399" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#4034D399" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-out line under a chart: monospace, muted. -->
    <Style x:Key="Readout" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- Highlighted explanation that changes with the experiment ("what you see now"). -->
    <Style x:Key="LiveExplain" TargetType="Border">
        <Setter Property="Background" Value="#0D22D3EE" />
        <Setter Property="BorderBrush" Value="#2E22D3EE" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
</ResourceDictionary>

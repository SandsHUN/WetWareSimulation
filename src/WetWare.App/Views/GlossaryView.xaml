<UserControl x:Class="WetWare.App.Views.GlossaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WetWare.App.Localization"
             xmlns:vm="clr-namespace:WetWare.App.ViewModels">
    <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,10,6" ToolTip="{loc:Tr Gloss.Search.Tip}" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextFaintBrush}" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="{loc:Tr Gloss.Search.Placeholder}" Foreground="{StaticResource TextFaintBrush}" Margin="36,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="{Binding CountText}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="4,0,0,6" />
                <ListBox ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GlossaryEntry}">
                            <StackPanel>
                                <TextBlock Text="{Binding Term}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource Caption}" FontWeight="Normal" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="28,24" DataContext="{Binding Selected}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding CategoryLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding Term}" Style="{StaticResource H1}" Margin="0,12,0,0" />
                    <TextBlock Text="{loc:Tr Gloss.Definition}" Style="{StaticResource Caption}" Margin="0,18,0,4" />
                    <TextBlock Text="{Binding Definition}" Style="{StaticResource Body}" FontSize="15" LineHeight="24" />
                    <Border Margin="0,18,0,0" Padding="16,12" CornerRadius="12" Background="#0D22D3EE" BorderBrush="#3322D3EE" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE82F;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Gloss.Why}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding Why}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Margin="0,18,0,0" HorizontalAlignment="Left" Padding="14,8"
                            Visibility="{Binding HasPage, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding PageKey}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Tr Gloss.TryIt}" />
                            <TextBlock Text="{Binding PageTitle}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="6,0,0,0" />
                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

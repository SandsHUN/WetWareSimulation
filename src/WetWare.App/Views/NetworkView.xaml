<UserControl x:Class="WetWare.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WetWare.App.Localization"
             xmlns:c="clr-namespace:WetWare.App.Controls"
             xmlns:vm="clr-namespace:WetWare.App.ViewModels"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <UserControl.Resources>
        <Style x:Key="MathOp" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MathFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="2,2,2,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="LegendDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Toolbar ============ -->
            <Border Style="{StaticResource Card}" Padding="12,10">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock Text="&#xE7BE;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="2,0,8,0" />
                        <ComboBox Width="290" ItemsSource="{Binding ScenarioOptions}" SelectedItem="{Binding SelectedScenario}"
                                  ToolTip="{loc:Tr Net.Scenario.Tip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" ToolTip="{Binding Tip}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="12,4" />
                        <Button Style="{StaticResource IconButton}" Command="{Binding TogglePlayCommand}" ToolTip="{loc:Tr Common.PlayPause.Tip}">
                            <TextBlock FontFamily="{StaticResource IconFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE769;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                <Setter Property="Text" Value="&#xE768;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Margin="6,0,0,0" Command="{Binding Step5Command}" ToolTip="{loc:Tr Net.Step5.Tip}" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="5 ms" />
                            </StackPanel>
                        </Button>
                        <Button Margin="6,0,0,0" Command="{Binding StepTinyCommand}" ToolTip="{loc:Tr Common.Step01.Tip}" Padding="10,6" Content="0,1 ms" />
                        <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Content="&#xE72C;" Command="{Binding RestartCommand}"
                                ToolTip="{loc:Tr Net.Restart.Tip}" />
                        <ComboBox Margin="8,0,0,0" Width="84" ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding Speed}"
                                  ItemStringFormat="{}{0}×" ToolTip="{loc:Tr Common.Speed.Tip}" />
                        <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="12,4" />
                        <Border Style="{StaticResource SegmentHost}" ToolTip="{loc:Tr Net.Tool.Tip}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentItem}" GroupName="Tool" IsChecked="{Binding IsSelectTool}" ToolTip="{loc:Tr Net.Tool.Select.Tip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B0;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Tr Net.Tool.Select}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentItem}" GroupName="Tool" IsChecked="{Binding IsStimulateTool}" ToolTip="{loc:Tr Net.Tool.Stimulate.Tip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Tr Net.Tool.Stimulate}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentItem}" GroupName="Tool" IsChecked="{Binding IsAblateTool}" ToolTip="{loc:Tr Net.Tool.Ablate.Tip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Tr Net.Tool.Ablate}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Width="180" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="{loc:Tr Net.Phase.Tip}">
                            <TextBlock Text="{Binding PhaseText}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Margin="0,5,0,0" Maximum="1" Value="{Binding PhaseProgress}"
                                         Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Mono}" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ Main dashboard ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: metrics + controls + scenario -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}" Padding="10">
                        <StackPanel>
                            <c:SectionHeader Glyph="&#xE9D9;" Title="{loc:Tr Net.Metrics}" Tip="{loc:Tr Net.Metrics.Tip}" Margin="6,4,0,6" />
                            <UniformGrid Columns="2">
                                <c:MetricTile Title="{loc:Tr Net.Sync}" Value="{Binding SyncText}" Unit="χ" Glyph="&#xE9D9;" Accent="{Binding SyncBrush}"
                                              Level="{Binding SyncLevel}" Tip="{loc:Tr Net.Sync.Tip}" />
                                <c:MetricTile Title="{loc:Tr Net.Rate}" Value="{Binding RateText}" Unit="Hz" Glyph="&#xEC4A;" Accent="{StaticResource AccentBrush}"
                                              Level="{Binding RateLevel}" Tip="{loc:Tr Net.Rate.Tip}" />
                                <c:MetricTile Title="{loc:Tr Net.Strong}" Value="{Binding StrongText}" Unit="%" Glyph="&#xE71B;" Accent="{StaticResource Accent2Brush}"
                                              Level="{Binding StrongLevel}" Tip="{loc:Tr Net.Strong.Tip}" />
                                <c:MetricTile Title="{loc:Tr Net.MeanW}" Value="{Binding MeanWeightText}" Unit="w" Glyph="&#xE9D2;" Accent="{StaticResource WarningBrush}"
                                              Level="{Binding MeanWeightLevel}" Tip="{loc:Tr Net.MeanW.Tip}" />
                                <c:MetricTile Title="{loc:Tr Net.Spikes}" Value="{Binding SpikesText}" Glyph="&#xE945;" Accent="{StaticResource ExcitatoryBrush}"
                                              Level="0" Tip="{loc:Tr Net.Spikes.Tip}" />
                                <c:MetricTile Title="{loc:Tr Net.AblatedCount}" Value="{Binding AblatedText}" Glyph="&#xE7BA;" Accent="{StaticResource DangerBrush}"
                                              Level="0" Tip="{loc:Tr Net.AblatedCount.Tip}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:SectionHeader Glyph="&#xE9F5;" Title="{loc:Tr Net.Controls}" Tip="{loc:Tr Net.Controls.Tip}" />
                            <CheckBox Content="{loc:Tr Net.Electrode}" IsChecked="{Binding ElectrodeOn}" ToolTip="{loc:Tr Net.Electrode.Tip}" Margin="0,0,0,6" />
                            <c:ParamSlider Label="{loc:Tr Net.ElectrodeCurrent}" Tip="{loc:Tr Net.ElectrodeCurrent.Tip}" Value="{Binding ElectrodeCurrent}"
                                           Minimum="0" Maximum="500" Step="10" Unit="pA" Decimals="0" />
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="{loc:Tr Common.Clear}" Command="{Binding ClearElectrodesCommand}" Padding="9,4" FontSize="12"
                                        ToolTip="{loc:Tr Net.ClearElectrodes.Tip}" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center">
                                    <Run Text="{loc:Tr Net.StimulatedCount}" />
                                    <Run Text="{Binding StimulatedCount, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                                </TextBlock>
                            </DockPanel>
                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,2,0,8" />
                            <CheckBox Content="{loc:Tr Net.Plasticity}" IsChecked="{Binding PlasticityEnabled}" ToolTip="{loc:Tr Net.Plasticity.Tip}" Margin="0,0,0,6" />
                            <c:ParamSlider Label="{loc:Tr Net.LearningRate}" Tip="{loc:Tr Net.LearningRate.Tip}" Value="{Binding LearningRate}"
                                           Minimum="0" Maximum="10" Step="0.1" Unit="×" Decimals="1" />
                            <c:ParamSlider Label="{loc:Tr Net.DepressionRatio}" Tip="{loc:Tr Net.DepressionRatio.Tip}" Value="{Binding DepressionRatio}"
                                           Minimum="0.2" Maximum="2" Step="0.05" Decimals="2" IsEnabled="{Binding ScenarioControlsRule, Converter={StaticResource InverseBool}}" />
                            <c:ParamSlider Label="{loc:Tr Net.Inhibition}" Tip="{loc:Tr Net.Inhibition.Tip}" Value="{Binding InhibitionGain}"
                                           Minimum="0" Maximum="2" Step="0.05" Unit="×" Decimals="2" IsEnabled="{Binding ScenarioControlsGains, Converter={StaticResource InverseBool}}" />
                            <c:ParamSlider Label="{loc:Tr Net.Excitation}" Tip="{loc:Tr Net.Excitation.Tip}" Value="{Binding ExcitationGain}"
                                           Minimum="0" Maximum="5" Step="0.05" Unit="×" Decimals="2" IsEnabled="{Binding ScenarioControlsGains, Converter={StaticResource InverseBool}}" />
                            <c:ParamSlider Label="{loc:Tr Net.NoiseRate}" Tip="{loc:Tr Net.NoiseRate.Tip}" Value="{Binding NoiseRate}"
                                           Minimum="0" Maximum="1500" Step="25" Unit="Hz" Decimals="0" />
                            <TextBlock Text="{loc:Tr Net.ScenarioControlled}" Style="{StaticResource Caption}" FontWeight="Normal"
                                       Visibility="{Binding ScenarioControlsGains, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{loc:Tr Net.ScenarioControlled}" Style="{StaticResource Caption}" FontWeight="Normal"
                                       Visibility="{Binding ScenarioControlsRule, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{loc:Tr Net.ClearAblations}" Command="{Binding ClearAblationsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    ToolTip="{loc:Tr Net.ClearAblations.Tip}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:SectionHeader Glyph="&#xE7BE;" Title="{Binding SelectedScenario.Label}" Tip="{loc:Tr Net.ScenarioInfo.Tip}" />
                            <TextBlock Text="{loc:Tr Scenarios.Phenomenon}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ScenarioPhenomenon}" Style="{StaticResource Body}" Margin="0,2,0,8" />
                            <TextBlock Text="{loc:Tr Scenarios.Observe}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ScenarioDescription}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: electrophysiology monitors -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:SectionHeader Glyph="&#xE9D9;" Title="{loc:Tr Net.Raster}" Tip="{loc:Tr Net.Raster.Tip}">
                                <c:SectionHeader.Actions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource ExcitatoryBrush}" />
                                        <TextBlock Text="{loc:Tr Net.Excitatory}" Style="{StaticResource Caption}" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource InhibitoryBrush}" />
                                        <TextBlock Text="{loc:Tr Net.Inhibitory}" Style="{StaticResource Caption}" FontWeight="Normal" VerticalAlignment="Center" />
                                    </StackPanel>
                                </c:SectionHeader.Actions>
                            </c:SectionHeader>
                            <c:RasterPlotControl x:Name="Raster" Height="300" RowCount="100" WindowMs="2000" />
                            <sp:WpfPlot x:Name="PopulationPlot" Height="110" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:SectionHeader Glyph="&#xE95E;" Title="{Binding SelectedTitle}" Tip="{loc:Tr Net.Scope.Tip}">
                                <c:SectionHeader.Actions>
                                    <TextBlock Text="{Binding SelectedInfo}" Style="{StaticResource Caption}" FontWeight="Normal" VerticalAlignment="Center" />
                                </c:SectionHeader.Actions>
                            </c:SectionHeader>
                            <sp:WpfPlot x:Name="ScopePlot" Height="200" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: topology & plasticity -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:SectionHeader Glyph="&#xEC26;" Title="{loc:Tr Net.Graph}" Tip="{loc:Tr Net.Graph.Tip}" />
                            <c:NetworkGraphControl x:Name="Graph" Height="400" />
                            <WrapPanel Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                    <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource ExcitatoryBrush}" />
                                    <TextBlock Text="{loc:Tr Net.Legend.Exc}" Style="{StaticResource Caption}" FontWeight="Normal" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                    <Ellipse Style="{StaticResource LegendDot}" Fill="{StaticResource InhibitoryBrush}" />
                                    <TextBlock Text="{loc:Tr Net.Legend.Inh}" Style="{StaticResource Caption}" FontWeight="Normal" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                    <Ellipse Style="{StaticResource LegendDot}" Fill="#FEF08A" />
                                    <TextBlock Text="{loc:Tr Net.Legend.Pulse}" Style="{StaticResource Caption}" FontWeight="Normal" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                    <Rectangle Width="26" Height="6" RadiusX="3" RadiusY="3" Margin="0,0,6,0" VerticalAlignment="Center" x:Name="WeightLegend" />
                                    <TextBlock Text="{loc:Tr Net.Legend.Weight}" Style="{StaticResource Caption}" FontWeight="Normal" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <StackPanel>
                                <c:SectionHeader Glyph="&#xE80A;" Title="{loc:Tr Net.Heatmap}" Tip="{loc:Tr Net.Heatmap.Tip}" />
                                <c:HeatmapControl x:Name="Heatmap" Height="230" />
                                <Rectangle Height="6" RadiusX="3" RadiusY="3" Margin="30,6,0,0" x:Name="HeatLegend" />
                                <DockPanel Margin="30,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="w = 1" Style="{StaticResource Caption}" FontWeight="Normal" />
                                    <TextBlock Text="w = 0" Style="{StaticResource Caption}" FontWeight="Normal" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12">
                            <StackPanel>
                                <c:SectionHeader Glyph="&#xE9D2;" Title="{loc:Tr Net.Histogram}" Tip="{loc:Tr Net.Histogram.Tip}" />
                                <sp:WpfPlot x:Name="HistogramPlot" Height="262" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- ============ Math lab + narrator ============ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE8EF;" Title="{loc:Tr Net.MathLab}" Tip="{loc:Tr Net.MathLab.Tip}" />
                        <TabControl>
                            <TabItem Header="{loc:Tr Net.Tab.Equation}">
                                <StackPanel>
                                    <WrapPanel HorizontalAlignment="Center" Margin="0,6,0,0">
                                        <c:EquationTerm Symbol="τ" Sub="m" ValueText="20 ms" Tip="{loc:Tr Term.TauM}" />
                                        <TextBlock Text="·" Style="{StaticResource MathOp}" />
                                        <c:EquationTerm Symbol="dv/dt" ValueText="{Binding DvdtText}" Tip="{loc:Tr Term.DvDt}" />
                                        <TextBlock Text="=" Style="{StaticResource MathOp}" />
                                        <TextBlock Text="−(" Style="{StaticResource MathOp}" />
                                        <c:EquationTerm Symbol="v" ValueText="{Binding VText}" ValueBrush="{Binding VBrush}" Tip="{loc:Tr Term.V}" />
                                        <TextBlock Text="−" Style="{StaticResource MathOp}" />
                                        <c:EquationTerm Symbol="E" Sub="L" ValueText="−70 mV" Tip="{loc:Tr Term.EL}" />
                                        <TextBlock Text=") + " Style="{StaticResource MathOp}" />
                                        <c:EquationTerm Symbol="R" Sub="m" ValueText="100 MΩ" Tip="{loc:Tr Term.Rm}" />
                                        <TextBlock Text="· (" Style="{StaticResource MathOp}" />
                                        <c:EquationTerm Symbol="I" Sub="syn" ValueText="{Binding SynText}" Tip="{loc:Tr Term.Isyn}" />
                                        <TextBlock Text="+" Style="{StaticResource MathOp}" />
                                        <c:EquationTerm Symbol="I" Sub="ext" ValueText="{Binding ExtText}" Tip="{loc:Tr Term.Iext}" />
                                        <TextBlock Text="+" Style="{StaticResource MathOp}" />
                                        <c:EquationTerm Symbol="I" Sub="noise" ValueText="{Binding NoiseText}" Tip="{loc:Tr Term.Inoise}" />
                                        <TextBlock Text=")" Style="{StaticResource MathOp}" />
                                    </WrapPanel>
                                    <Border Style="{StaticResource InsetPanel}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr Net.StdpRule}" Style="{StaticResource Caption}" />
                                            <TextBlock Style="{StaticResource Mono}" Margin="0,4,0,0"
                                                       Text="Δw = A+·exp(−Δt/τ+)  if Δt &gt; 0 (LTP)      Δw = −A−·exp(Δt/τ−)  if Δt &lt; 0 (LTD)      Δt = t_post − t_pre" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{loc:Tr Neuron.Equation.Hint}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,8,0,0" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="{loc:Tr Net.Tab.Stdp}">
                                <StackPanel>
                                    <sp:WpfPlot x:Name="StdpPlot" Height="260" />
                                    <TextBlock Text="{Binding LatestStdpText}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="{loc:Tr Net.Tab.Phase}">
                                <StackPanel>
                                    <sp:WpfPlot x:Name="PhasePlot" Height="260" />
                                    <TextBlock Text="{loc:Tr Net.Phase.Note}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="{loc:Tr Net.Tab.Debugger}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{loc:Tr Debug.Freeze}" Command="{Binding StepTinyCommand}" ToolTip="{loc:Tr Debug.Freeze.Tip}" Padding="10,5" FontSize="12" />
                                            <Button Content="{loc:Tr Common.Continue}" Command="{Binding TogglePlayCommand}" Margin="6,0,0,0" Padding="10,5" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Text="{loc:Tr Net.Debugger.Note}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <c:BioDebuggerPanel Lines="{Binding DebugLines}" />
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <c:SectionHeader DockPanel.Dock="Top" Glyph="&#xE8BD;" Title="{loc:Tr Common.WhatsHappening}" Tip="{loc:Tr Net.Narrator.Tip}">
                            <c:SectionHeader.Actions>
                                <Button Style="{StaticResource GhostButton}" Content="{loc:Tr Common.Clear}" Command="{Binding ClearLogCommand}" Padding="8,3" FontSize="12" />
                            </c:SectionHeader.Actions>
                        </c:SectionHeader>
                        <ScrollViewer Height="330" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Narratives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NarrativeEntry}">
                                        <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="8" Background="{StaticResource Bg1Brush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="Bar" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" />
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" FontSize="12.5" LineHeight="18" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Spike">
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource ExcitatoryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Ltp">
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Ltd">
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Phase">
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource Accent2Brush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Alert">
                                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

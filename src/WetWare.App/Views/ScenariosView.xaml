<UserControl x:Class="WetWare.App.Views.ScenariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WetWare.App.Localization"
             xmlns:vm="clr-namespace:WetWare.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScenarioCard}">
                        <Border Style="{StaticResource Card}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding AccentHex}" Opacity="0.16" />
                                        </Border.Background>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{Binding AccentHex}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding Duration}" FontSize="11.5" Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="18" />
                                        <TextBlock Text="{Binding Phenomenon}" Foreground="{Binding AccentHex}" FontWeight="SemiBold" FontSize="12.5" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Text="{loc:Tr Scenarios.Observe}" Style="{StaticResource Caption}" Margin="0,14,0,3" />
                                <TextBlock Grid.Row="2" Text="{Binding Observe}" Style="{StaticResource Body}" />
                                <Border Grid.Row="3" Style="{StaticResource InsetPanel}" Margin="0,12,0,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Tr Scenarios.Steps}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding Steps}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Button Grid.Row="4" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="16,8"
                                        Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}" ToolTip="{loc:Tr Scenarios.Start.Tip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:Tr Scenarios.Start}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

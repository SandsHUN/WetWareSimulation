<UserControl x:Class="WetWare.App.Views.NeuronLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WetWare.App.Localization"
             xmlns:c="clr-namespace:WetWare.App.Controls"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- ============ Controls ============ -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE945;" Title="{loc:Tr Neuron.Examples}" Tip="{loc:Tr Neuron.Examples.Tip}" />
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" ToolTip="{Binding Tip}" Margin="0,0,6,6" Padding="10,5" FontSize="12"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Value}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE945;" Title="{loc:Tr Neuron.Electrode}" Tip="{loc:Tr Neuron.Electrode.Tip}" />
                        <TextBlock Text="{loc:Tr Neuron.Shape}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Shapes}" SelectedItem="{Binding SelectedShape}" DisplayMemberPath="Label"
                                  ToolTip="{Binding SelectedShape.Tip}" Margin="0,0,0,8" />
                        <c:ParamSlider Label="{loc:Tr Neuron.Amplitude}" Tip="{loc:Tr Neuron.Amplitude.Tip}" Value="{Binding Amplitude}"
                                       Minimum="0" Maximum="600" Step="5" Unit="pA" Decimals="0" />
                        <c:ParamSlider Label="{loc:Tr Neuron.Frequency}" Tip="{loc:Tr Neuron.Frequency.Tip}" Value="{Binding Frequency}"
                                       Minimum="1" Maximum="50" Step="1" Unit="Hz" Decimals="0"
                                       Visibility="{Binding ShowFrequency, Converter={StaticResource BoolToVisibility}}" />
                        <c:ParamSlider Label="{loc:Tr Neuron.PulseWidth}" Tip="{loc:Tr Neuron.PulseWidth.Tip}" Value="{Binding PulseWidth}"
                                       Minimum="2" Maximum="80" Step="1" Unit="ms" Decimals="0"
                                       Visibility="{Binding ShowPulseWidth, Converter={StaticResource BoolToVisibility}}" />
                        <c:ParamSlider Label="{loc:Tr Neuron.Noise}" Tip="{loc:Tr Neuron.Noise.Tip}" Value="{Binding NoiseSigma}"
                                       Minimum="0" Maximum="200" Step="5" Unit="pA" Decimals="0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE9D2;" Title="{loc:Tr Neuron.Membrane}" Tip="{loc:Tr Neuron.Membrane.Tip}" />
                        <c:ParamSlider Label="{loc:Tr Param.TauM}" Tip="{loc:Tr Param.TauM.Tip}" Value="{Binding TauM}"
                                       Minimum="2" Maximum="60" Step="1" Unit="ms" Decimals="0" />
                        <c:ParamSlider Label="{loc:Tr Param.EL}" Tip="{loc:Tr Param.EL.Tip}" Value="{Binding RestingPotential}"
                                       Minimum="-85" Maximum="-55" Step="1" Unit="mV" Decimals="0" />
                        <c:ParamSlider Label="{loc:Tr Param.VTh}" Tip="{loc:Tr Param.VTh.Tip}" Value="{Binding Threshold}"
                                       Minimum="-60" Maximum="-35" Step="1" Unit="mV" Decimals="0" />
                        <c:ParamSlider Label="{loc:Tr Param.VReset}" Tip="{loc:Tr Param.VReset.Tip}" Value="{Binding ResetPotential}"
                                       Minimum="-80" Maximum="-50" Step="1" Unit="mV" Decimals="0" />
                        <c:ParamSlider Label="{loc:Tr Param.Rm}" Tip="{loc:Tr Param.Rm.Tip}" Value="{Binding Resistance}"
                                       Minimum="20" Maximum="300" Step="5" Unit="MΩ" Decimals="0" />
                        <c:ParamSlider Label="{loc:Tr Param.TauRef}" Tip="{loc:Tr Param.TauRef.Tip}" Value="{Binding RefractoryPeriod}"
                                       Minimum="0" Maximum="20" Step="0.5" Unit="ms" Decimals="1" />
                        <Button Content="{loc:Tr Common.Defaults}" ToolTip="{loc:Tr Common.Defaults.Tip}" Command="{Binding RestoreDefaultsCommand}"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ Oscilloscope ============ -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE9D9;" Title="{loc:Tr Neuron.Scope}" Tip="{loc:Tr Neuron.Scope.Tip}">
                            <c:SectionHeader.Actions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Mono}" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding Speed}" ItemStringFormat="{}{0}×" Width="84"
                                              ToolTip="{loc:Tr Common.Speed.Tip}" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleRunCommand}" ToolTip="{loc:Tr Common.PlayPause.Tip}">
                                        <TextBlock FontFamily="{StaticResource IconFont}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE769;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                            <Setter Property="Text" Value="&#xE768;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Margin="6,0,0,0" Command="{Binding StepOnceCommand}"
                                            ToolTip="{loc:Tr Common.Step01.Tip}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xEB9D;" Margin="6,0,0,0" Command="{Binding StepManyCommand}"
                                            ToolTip="{loc:Tr Common.Step1.Tip}" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="6,0,0,0" Command="{Binding ResetCommand}"
                                            ToolTip="{loc:Tr Common.Reset.Tip}" />
                                </StackPanel>
                            </c:SectionHeader.Actions>
                        </c:SectionHeader>
                        <sp:WpfPlot x:Name="ScopePlot" Height="300" />
                        <sp:WpfPlot x:Name="CurrentPlot" Height="120" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <UniformGrid Columns="5" Margin="2,0">
                    <c:MetricTile Title="{loc:Tr Neuron.Measured}" Value="{Binding MeasuredRateText}" Glyph="&#xE9D9;" Accent="{StaticResource AccentBrush}"
                                  Tip="{loc:Tr Neuron.Measured.Tip}" Level="{Binding RateLevel}" />
                    <c:MetricTile Title="{loc:Tr Neuron.Theory}" Value="{Binding TheoryRateText}" Glyph="&#xE8EF;" Accent="{StaticResource Accent2Brush}"
                                  Tip="{loc:Tr Neuron.Theory.Tip}" Level="{Binding RateLevel}" />
                    <c:MetricTile Title="{loc:Tr Neuron.Rheobase}" Value="{Binding RheobaseText}" Glyph="&#xE945;" Accent="{StaticResource WarningBrush}"
                                  Tip="{loc:Tr Neuron.Rheobase.Tip}" Level="0.5" />
                    <c:MetricTile Title="{loc:Tr Neuron.FixedPoint}" Value="{Binding FixedPointText}" Glyph="&#xE7B7;" Accent="{StaticResource SuccessBrush}"
                                  Tip="{loc:Tr Neuron.FixedPoint.Tip}" Level="0.5" />
                    <c:MetricTile Title="{loc:Tr Neuron.Capacitance}" Value="{Binding CapacitanceText}" Glyph="&#xE83E;" Accent="{StaticResource InhibitoryBrush}"
                                  Tip="{loc:Tr Neuron.Capacitance.Tip}" Level="0.5" />
                </UniformGrid>
            </StackPanel>

            <!-- ============ Live equation, narrator, debugger ============ -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE8EF;" Title="{loc:Tr Neuron.Equation}" Tip="{loc:Tr Neuron.Equation.Tip}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <c:EquationTerm Symbol="τ" Sub="m" ValueText="{Binding TauText}" Tip="{loc:Tr Term.TauM}" />
                            <TextBlock Text="·" FontFamily="{StaticResource MathFont}" FontSize="22" Margin="1,2,1,0" />
                            <c:EquationTerm Symbol="dv/dt" ValueText="{Binding DvdtText}" Tip="{loc:Tr Term.DvDt}" />
                            <TextBlock Text="=" FontFamily="{StaticResource MathFont}" FontSize="22" Margin="3,2,3,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="−(" FontFamily="{StaticResource MathFont}" FontSize="22" Margin="0,2,0,0" />
                            <c:EquationTerm Symbol="v" ValueText="{Binding VText}" ValueBrush="{Binding VBrush}" Tip="{loc:Tr Term.V}" />
                            <TextBlock Text="−" FontFamily="{StaticResource MathFont}" FontSize="22" Margin="1,2,1,0" />
                            <c:EquationTerm Symbol="E" Sub="L" ValueText="{Binding RestText}" Tip="{loc:Tr Term.EL}" />
                            <TextBlock Text=")+" FontFamily="{StaticResource MathFont}" FontSize="22" Margin="0,2,0,0" />
                            <c:EquationTerm Symbol="R" Sub="m" ValueText="{Binding ResistanceText}" Tip="{loc:Tr Term.Rm}" />
                            <TextBlock Text="·" FontFamily="{StaticResource MathFont}" FontSize="22" Margin="1,2,1,0" />
                            <c:EquationTerm Symbol="I" ValueText="{Binding CurrentText}" Tip="{loc:Tr Term.I}" />
                        </StackPanel>
                        <Border Style="{StaticResource InsetPanel}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Neuron.Reset}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{loc:Tr Neuron.ResetRule}" Style="{StaticResource Mono}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{loc:Tr Neuron.Equation.Hint}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE8BD;" Title="{loc:Tr Common.WhatsHappening}" Tip="{loc:Tr Common.WhatsHappening.Tip}" />
                        <TextBlock Text="{Binding Narrative}" Style="{StaticResource Body}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xEBE8;" Title="{loc:Tr Debug.Title}" Tip="{loc:Tr Debug.Title.Tip}">
                            <c:SectionHeader.Actions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{loc:Tr Debug.Freeze}" ToolTip="{loc:Tr Debug.Freeze.Tip}" Command="{Binding StepOnceCommand}" Padding="10,5" FontSize="12" />
                                </StackPanel>
                            </c:SectionHeader.Actions>
                        </c:SectionHeader>
                        <c:BioDebuggerPanel Lines="{Binding DebugLines}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ Dynamics ============ -->
            <Grid Grid.Row="1" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE7B7;" Title="{loc:Tr Neuron.PhasePlane}" Tip="{loc:Tr Neuron.PhasePlane.Tip}" />
                        <sp:WpfPlot x:Name="PhasePlot" Height="300" />
                        <TextBlock Text="{Binding PhaseNarrative}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE9D2;" Title="{loc:Tr Neuron.FICurve}" Tip="{loc:Tr Neuron.FICurve.Tip}" />
                        <sp:WpfPlot x:Name="FiPlot" Height="300" />
                        <TextBlock Text="{loc:Tr Neuron.FICurve.Note}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

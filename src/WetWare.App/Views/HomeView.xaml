<UserControl x:Class="WetWare.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WetWare.App.Localization"
             xmlns:c="clr-namespace:WetWare.App.Controls"
             xmlns:vm="clr-namespace:WetWare.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,16">
            <!-- Hero -->
            <Border Margin="6" CornerRadius="18" Background="{StaticResource HeroGradientBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1" ClipToBounds="True">
                <Grid MinHeight="330">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="36,32,16,32" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Tr Home.Badge}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{loc:Tr Home.Hero.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="46" />
                        <TextBlock Text="{loc:Tr Home.Hero.Text}" Style="{StaticResource Muted}" FontSize="15" LineHeight="23" Margin="0,12,0,0" MaxWidth="620"
                                   HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}" CommandParameter="Neuron" Padding="18,10"
                                    ToolTip="{loc:Tr Page.Neuron.Tip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Tr Home.Start}" FontSize="14" />
                                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenCommand}" CommandParameter="Scenarios" Padding="18,10" Margin="10,0,0,0"
                                    ToolTip="{loc:Tr Page.Scenarios.Tip}">
                                <TextBlock Text="{loc:Tr Home.Experiments}" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="0,10,20,10">
                        <Ellipse Width="360" Height="360" Opacity="0.35">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="#3322D3EE" />
                                    <GradientStop Offset="1" Color="#00A78BFA" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <c:NetworkGraphControl x:Name="HeroGraph" ShowSelectedEdges="False" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Modules -->
            <TextBlock Text="{loc:Tr Home.Modules}" Style="{StaticResource H2}" Margin="10,18,0,4" />
            <TextBlock Text="{loc:Tr Home.Modules.Sub}" Style="{StaticResource Muted}" Margin="10,0,0,6" />
            <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModuleCard}">
                        <Button Margin="6" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding PageKey}" ToolTip="{Binding Description}">
                            <Grid Margin="18,16" MinHeight="128">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Width="40" Height="40" CornerRadius="11" HorizontalAlignment="Left">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding AccentHex}" Opacity="0.15" />
                                    </Border.Background>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="19" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{Binding AccentHex}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Title}" Style="{StaticResource H3}" FontSize="15.5" Margin="0,12,0,0" HorizontalAlignment="Left" />
                                <TextBlock Grid.Row="2" Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12.5" LineHeight="18" Margin="0,4,0,0"
                                           HorizontalAlignment="Left" TextAlignment="Left" />
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{loc:Tr Common.Open}" Foreground="{Binding AccentHex}" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{Binding AccentHex}"
                                               VerticalAlignment="Center" Margin="6,1,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Background -->
            <UniformGrid Columns="3" Margin="0,8,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE95E;" Title="{loc:Tr Home.What.Title}" />
                        <TextBlock Text="{loc:Tr Home.What.Text}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE897;" Title="{loc:Tr Home.How.Title}" />
                        <TextBlock Text="{loc:Tr Home.How.Text}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE950;" Title="{loc:Tr Home.Model.Title}" />
                        <TextBlock Text="{loc:Tr Home.Model.Text}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="WetWare.App.Views.VisionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WetWare.App.Localization"
             xmlns:c="clr-namespace:WetWare.App.Controls"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <UserControl.Resources>
        <Style x:Key="StageCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="StageNumber" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="StageNumberText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#06101F" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE7B3;" Title="{loc:Tr Vision.Stimulus}" Tip="{loc:Tr Vision.Stimulus.Tip}" />
                        <ComboBox ItemsSource="{Binding Stimuli}" SelectedItem="{Binding SelectedStimulus}" Margin="0,0,0,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" ToolTip="{Binding Tip}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <c:ParamSlider Label="{loc:Tr Vision.Angle}" Tip="{loc:Tr Vision.Angle.Tip}" Value="{Binding Angle}"
                                       Minimum="0" Maximum="180" Step="5" Unit="°" Decimals="0"
                                       Visibility="{Binding AngleRelevant, Converter={StaticResource BoolToVisibility}}" />
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,6,0,10" />
                        <CheckBox Content="{loc:Tr Vision.Paint}" IsChecked="{Binding PaintMode}" ToolTip="{loc:Tr Vision.Paint.Tip}" Margin="0,0,0,8" />
                        <StackPanel Visibility="{Binding PaintMode, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="{loc:Tr Vision.PaintWhite}" IsChecked="{Binding PaintWhite}" ToolTip="{loc:Tr Vision.PaintWhite.Tip}" Margin="0,0,0,6" />
                            <c:ParamSlider Label="{loc:Tr Vision.Brush}" Value="{Binding BrushSize}" Minimum="1" Maximum="8" Step="1" Unit="px" Decimals="0" />
                        </StackPanel>
                        <WrapPanel>
                            <Button Content="{loc:Tr Vision.Clear}" ToolTip="{loc:Tr Vision.Clear.Tip}" Command="{Binding ClearCanvasCommand}" Margin="0,0,6,6" />
                            <Button ToolTip="{loc:Tr Vision.Load.Tip}" Command="{Binding LoadImageCommand}" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{loc:Tr Vision.Load}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE9D2;" Title="{loc:Tr Vision.Receptive}" Tip="{loc:Tr Vision.Receptive.Tip}" />
                        <c:ParamSlider Label="{loc:Tr Vision.Center}" Tip="{loc:Tr Vision.Center.Tip}" Value="{Binding CenterSigma}"
                                       Minimum="0.5" Maximum="4" Step="0.25" Unit="px" Decimals="2" />
                        <c:ParamSlider Label="{loc:Tr Vision.Surround}" Tip="{loc:Tr Vision.Surround.Tip}" Value="{Binding SurroundSigma}"
                                       Minimum="1" Maximum="9" Step="0.25" Unit="px" Decimals="2" />
                        <c:ParamSlider Label="{loc:Tr Vision.Inhibition}" Tip="{loc:Tr Vision.Inhibition.Tip}" Value="{Binding SurroundWeight}"
                                       Minimum="0" Maximum="1.2" Step="0.05" Decimals="2" />
                        <c:ParamSlider Label="{loc:Tr Vision.Wavelength}" Tip="{loc:Tr Vision.Wavelength.Tip}" Value="{Binding Wavelength}"
                                       Minimum="4" Maximum="20" Step="1" Unit="px" Decimals="0" />
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="{loc:Tr Vision.Preset.Strong}" ToolTip="{loc:Tr Vision.Preset.Strong.Tip}" Command="{Binding ApplyPresetCommand}" CommandParameter="Strong" Margin="0,0,6,6" Padding="9,4" FontSize="12" />
                            <Button Content="{loc:Tr Vision.Preset.None}" ToolTip="{loc:Tr Vision.Preset.None.Tip}" Command="{Binding ApplyPresetCommand}" CommandParameter="None" Margin="0,0,6,6" Padding="9,4" FontSize="12" />
                            <Button Content="{loc:Tr Vision.Preset.Wide}" ToolTip="{loc:Tr Vision.Preset.Wide.Tip}" Command="{Binding ApplyPresetCommand}" CommandParameter="Wide" Margin="0,0,6,6" Padding="9,4" FontSize="12" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE8B9;" Title="{loc:Tr Vision.Kernels}" Tip="{loc:Tr Vision.Kernels.Tip}" />
                        <UniformGrid Columns="5">
                            <StackPanel Margin="2" ToolTip="{loc:Tr Vision.Kernel.DoG.Tip}">
                                <c:ImageViewControl x:Name="DogKernel" Height="44" />
                                <TextBlock Text="DoG" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="2" ToolTip="{loc:Tr Vision.Kernel.Gabor.Tip}">
                                <c:ImageViewControl x:Name="Gabor0" Height="44" />
                                <TextBlock Text="0°" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="2" ToolTip="{loc:Tr Vision.Kernel.Gabor.Tip}">
                                <c:ImageViewControl x:Name="Gabor45" Height="44" />
                                <TextBlock Text="45°" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="2" ToolTip="{loc:Tr Vision.Kernel.Gabor.Tip}">
                                <c:ImageViewControl x:Name="Gabor90" Height="44" />
                                <TextBlock Text="90°" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="2" ToolTip="{loc:Tr Vision.Kernel.Gabor.Tip}">
                                <c:ImageViewControl x:Name="Gabor135" Height="44" />
                                <TextBlock Text="135°" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <!-- Processing stages -->
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StageNumber}"><TextBlock Text="1" Style="{StaticResource StageNumberText}" /></Border>
                                <TextBlock Text="{loc:Tr Vision.Stage.Input}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                                <c:InfoTip Text="{loc:Tr Vision.Stage.Input.Tip}" Margin="8,0,0,0" />
                            </StackPanel>
                            <c:ImageViewControl x:Name="InputView" Height="230" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StageNumber}"><TextBlock Text="2" Style="{StaticResource StageNumberText}" /></Border>
                                <TextBlock Text="{loc:Tr Vision.Stage.On}" Style="{StaticResource H3}" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" />
                                <c:InfoTip Text="{loc:Tr Vision.Stage.On.Tip}" Margin="8,0,0,0" />
                            </StackPanel>
                            <c:ImageViewControl x:Name="OnView" Height="230" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StageNumber}"><TextBlock Text="3" Style="{StaticResource StageNumberText}" /></Border>
                                <TextBlock Text="{loc:Tr Vision.Stage.Off}" Style="{StaticResource H3}" VerticalAlignment="Center" Foreground="#F472B6" />
                                <c:InfoTip Text="{loc:Tr Vision.Stage.Off.Tip}" Margin="8,0,0,0" />
                            </StackPanel>
                            <c:ImageViewControl x:Name="OffView" Height="230" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StageNumber}"><TextBlock Text="4" Style="{StaticResource StageNumberText}" /></Border>
                                <TextBlock Text="{loc:Tr Vision.Stage.Contrast}" Style="{StaticResource H3}" VerticalAlignment="Center" />
                                <c:InfoTip Text="{loc:Tr Vision.Stage.Contrast.Tip}" Margin="8,0,0,0" />
                            </StackPanel>
                            <c:ImageViewControl x:Name="ContrastView" Height="230" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StageNumber}"><TextBlock Text="5" Style="{StaticResource StageNumberText}" /></Border>
                                <TextBlock Text="{loc:Tr Vision.Stage.V1}" Style="{StaticResource H3}" VerticalAlignment="Center" Foreground="{StaticResource Accent2Brush}" />
                                <c:InfoTip Text="{loc:Tr Vision.Stage.V1.Tip}" Margin="8,0,0,0" />
                            </StackPanel>
                            <c:ImageViewControl x:Name="OrientationView" Height="206" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" x:Name="OrientationLegend" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StageNumber}"><TextBlock Text="6" Style="{StaticResource StageNumberText}" /></Border>
                                <TextBlock Text="{loc:Tr Vision.Stage.Spikes}" Style="{StaticResource H3}" VerticalAlignment="Center" Foreground="{StaticResource WarningBrush}" />
                                <c:InfoTip Text="{loc:Tr Vision.Stage.Spikes.Tip}" Margin="8,0,0,0" />
                                <CheckBox IsChecked="{Binding SpikesRunning}" Margin="10,0,0,0" ToolTip="{loc:Tr Common.PlayPause.Tip}" />
                            </StackPanel>
                            <c:ImageViewControl x:Name="SpikeView" Height="206" />
                            <TextBlock Text="{Binding SpikeRateText}" Style="{StaticResource Caption}" FontWeight="Normal" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:SectionHeader Glyph="&#xE9D9;" Title="{loc:Tr Vision.Profile}" Tip="{loc:Tr Vision.Profile.Tip}" />
                            <sp:WpfPlot x:Name="ProfilePlot" Height="250" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <c:SectionHeader Glyph="&#xE8BD;" Title="{loc:Tr Common.WhatsHappening}" Tip="{loc:Tr Vision.Explain.Tip}" />
                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}" />
                            <Border Style="{StaticResource InsetPanel}" Margin="0,12,0,0">
                                <TextBlock Text="{loc:Tr Vision.Pathway}" Style="{StaticResource Muted}" FontSize="12.5" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

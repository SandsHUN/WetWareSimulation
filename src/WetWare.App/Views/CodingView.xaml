<UserControl x:Class="WetWare.App.Views.CodingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WetWare.App.Localization"
             xmlns:c="clr-namespace:WetWare.App.Controls"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <UserControl.Resources>
        <Style x:Key="SchemeCard" TargetType="Border" BasedOn="{StaticResource InsetPanel}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="TableCell" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="TableHead" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="8,6" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE9D9;" Title="{loc:Tr Coding.Raster}" Tip="{loc:Tr Coding.Raster.Tip}">
                            <c:SectionHeader.Actions>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding Speed}" ItemStringFormat="{}{0}×" Width="84"
                                              ToolTip="{loc:Tr Common.Speed.Tip}" Margin="0,0,6,0" />
                                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleRunCommand}" ToolTip="{loc:Tr Common.PlayPause.Tip}">
                                        <TextBlock FontFamily="{StaticResource IconFont}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE769;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                            <Setter Property="Text" Value="&#xE768;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </c:SectionHeader.Actions>
                        </c:SectionHeader>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:ParamSlider Label="{loc:Tr Coding.Stimulus}" Tip="{loc:Tr Coding.Stimulus.Tip}" Value="{Binding Stimulus}"
                                           Minimum="0" Maximum="1" Step="0.01" Decimals="2" Margin="0,0,16,0" />
                            <CheckBox Grid.Column="1" Content="{loc:Tr Coding.Sweep}" IsChecked="{Binding AutoSweep}" ToolTip="{loc:Tr Coding.Sweep.Tip}"
                                      VerticalAlignment="Center" />
                        </Grid>
                        <c:RasterPlotControl x:Name="Raster" Height="430" RowCount="36" WindowMs="1000" SpikeWidth="3" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE82D;" Title="{loc:Tr Coding.Schemes}" Tip="{loc:Tr Coding.Schemes.Tip}" />
                        <Border Style="{StaticResource SchemeCard}" BorderBrush="#5534D399">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Coding.Rate}" Style="{StaticResource H3}" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="{loc:Tr Coding.Rate.Text}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,4" />
                                <TextBlock Text="{Binding RateReadout}" Style="{StaticResource Mono}" Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SchemeCard}" BorderBrush="#55FBBF24">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Coding.Latency}" Style="{StaticResource H3}" Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="{loc:Tr Coding.Latency.Text}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,4" />
                                <TextBlock Text="{Binding LatencyReadout}" Style="{StaticResource Mono}" Foreground="{StaticResource WarningBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SchemeCard}" BorderBrush="#55F472B6">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Coding.Phase}" Style="{StaticResource H3}" Foreground="#F472B6" />
                                <TextBlock Text="{loc:Tr Coding.Phase.Text}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,4" />
                                <TextBlock Text="{Binding PhaseReadout}" Style="{StaticResource Mono}" Foreground="#F472B6" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SchemeCard}" BorderBrush="#5522D3EE">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Coding.Population}" Style="{StaticResource H3}" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{loc:Tr Coding.Population.Text}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,4" />
                                <TextBlock Text="{Binding PopulationReadout}" Style="{StaticResource Mono}" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE9D2;" Title="{loc:Tr Coding.Tuning}" Tip="{loc:Tr Coding.Tuning.Tip}" />
                        <sp:WpfPlot x:Name="TuningPlot" Height="230" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                <StackPanel>
                    <c:SectionHeader Glyph="&#xE8EF;" Title="{loc:Tr Coding.Compare}" Tip="{loc:Tr Coding.Compare.Tip}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.ColumnSpan="5" Background="{StaticResource Bg1Brush}" CornerRadius="8" />
                        <TextBlock Grid.Column="0" Text="{loc:Tr Coding.Table.Scheme}" Style="{StaticResource TableHead}" />
                        <TextBlock Grid.Column="1" Text="{loc:Tr Coding.Table.Speed}" Style="{StaticResource TableHead}" />
                        <TextBlock Grid.Column="2" Text="{loc:Tr Coding.Table.Robust}" Style="{StaticResource TableHead}" />
                        <TextBlock Grid.Column="3" Text="{loc:Tr Coding.Table.Energy}" Style="{StaticResource TableHead}" />
                        <TextBlock Grid.Column="4" Text="{loc:Tr Coding.Table.Brain}" Style="{StaticResource TableHead}" />

                        <TextBlock Grid.Row="1" Text="{loc:Tr Coding.Rate}" Style="{StaticResource TableCell}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Tr Coding.Table.Rate.Speed}" Style="{StaticResource TableCell}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Tr Coding.Table.Rate.Robust}" Style="{StaticResource TableCell}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{loc:Tr Coding.Table.Rate.Energy}" Style="{StaticResource TableCell}" />
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="{loc:Tr Coding.Table.Rate.Brain}" Style="{StaticResource TableCell}" />

                        <TextBlock Grid.Row="2" Text="{loc:Tr Coding.Latency}" Style="{StaticResource TableCell}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Tr Coding.Table.Latency.Speed}" Style="{StaticResource TableCell}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:Tr Coding.Table.Latency.Robust}" Style="{StaticResource TableCell}" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{loc:Tr Coding.Table.Latency.Energy}" Style="{StaticResource TableCell}" />
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="{loc:Tr Coding.Table.Latency.Brain}" Style="{StaticResource TableCell}" />

                        <TextBlock Grid.Row="3" Text="{loc:Tr Coding.Phase}" Style="{StaticResource TableCell}" Foreground="#F472B6" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Tr Coding.Table.Phase.Speed}" Style="{StaticResource TableCell}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{loc:Tr Coding.Table.Phase.Robust}" Style="{StaticResource TableCell}" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{loc:Tr Coding.Table.Phase.Energy}" Style="{StaticResource TableCell}" />
                        <TextBlock Grid.Row="3" Grid.Column="4" Text="{loc:Tr Coding.Table.Phase.Brain}" Style="{StaticResource TableCell}" />

                        <TextBlock Grid.Row="4" Text="{loc:Tr Coding.Population}" Style="{StaticResource TableCell}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{loc:Tr Coding.Table.Pop.Speed}" Style="{StaticResource TableCell}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{loc:Tr Coding.Table.Pop.Robust}" Style="{StaticResource TableCell}" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="{loc:Tr Coding.Table.Pop.Energy}" Style="{StaticResource TableCell}" />
                        <TextBlock Grid.Row="4" Grid.Column="4" Text="{loc:Tr Coding.Table.Pop.Brain}" Style="{StaticResource TableCell}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

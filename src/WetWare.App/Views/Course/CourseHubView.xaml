<UserControl x:Class="WetWare.App.Views.Course.CourseHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:WetWare.App.Localization"
             xmlns:c="clr-namespace:WetWare.App.Controls"
             xmlns:course="clr-namespace:WetWare.App.ViewModels.Course">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,16">
            <!-- ============ Hero ============ -->
            <Border Margin="6" CornerRadius="20" Background="{StaticResource CourseHeroBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1" ClipToBounds="True">
                <Grid MinHeight="300">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="36,30,16,30" VerticalAlignment="Center">
                        <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" Background="#1AA78BFA" BorderBrush="#40A78BFA" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BE;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource Accent2Brush}"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Tr Course.Hub.Badge}" Foreground="{StaticResource Accent2Brush}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{loc:Tr Course.Hub.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="SemiBold"
                                   Foreground="{StaticResource CourseGradientBrush}" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="46" />
                        <TextBlock Text="{loc:Tr Course.Hub.Text}" Style="{StaticResource Muted}" FontSize="15" LineHeight="23" Margin="0,10,0,0" MaxWidth="660"
                                   HorizontalAlignment="Left" />
                        <!-- Study loop: read → experiment → check -->
                        <WrapPanel Margin="0,20,0,0">
                            <Border CornerRadius="12" Padding="12,8" Background="#14FFFFFF" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE736;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="{loc:Tr Course.Hub.Step1}" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Tr Course.Hub.Step1.Text}" Style="{StaticResource Caption}" FontWeight="Normal" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <Border CornerRadius="12" Padding="12,8" Background="#14FFFFFF" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent2Brush}" VerticalAlignment="Center" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="{loc:Tr Course.Hub.Step2}" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Tr Course.Hub.Step2.Text}" Style="{StaticResource Caption}" FontWeight="Normal" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <Border CornerRadius="12" Padding="12,8" Background="#14FFFFFF" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9CE;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent3Brush}" VerticalAlignment="Center" />
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="{loc:Tr Course.Hub.Step3}" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Tr Course.Hub.Step3.Text}" Style="{StaticResource Caption}" FontWeight="Normal" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{loc:Tr Course.Hub.Source}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Decorative: three overlapping module orbs -->
                    <Canvas Grid.Column="1" Width="360" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Ellipse Canvas.Left="20" Canvas.Top="30" Width="190" Height="190" Opacity="0.55">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.35,0.3">
                                    <GradientStop Offset="0" Color="#9922D3EE" />
                                    <GradientStop Offset="1" Color="#006366F1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Canvas.Left="150" Canvas.Top="10" Width="180" Height="180" Opacity="0.55">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.35,0.3">
                                    <GradientStop Offset="0" Color="#99A78BFA" />
                                    <GradientStop Offset="1" Color="#00F472B6" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Canvas.Left="100" Canvas.Top="120" Width="180" Height="180" Opacity="0.55">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.35,0.3">
                                    <GradientStop Offset="0" Color="#99FBBF24" />
                                    <GradientStop Offset="1" Color="#00FB7185" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Canvas.Left="88" Canvas.Top="96" Text="6" FontFamily="{StaticResource DisplayFont}" FontSize="54" FontWeight="Bold" Foreground="#E0FFFFFF" />
                        <TextBlock Canvas.Left="228" Canvas.Top="70" Text="7" FontFamily="{StaticResource DisplayFont}" FontSize="54" FontWeight="Bold" Foreground="#E0FFFFFF" />
                        <TextBlock Canvas.Left="176" Canvas.Top="186" Text="8" FontFamily="{StaticResource DisplayFont}" FontSize="54" FontWeight="Bold" Foreground="#E0FFFFFF" />
                    </Canvas>
                </Grid>
            </Border>

            <!-- ============ Storyline ============ -->
            <Border Style="{StaticResource Card}" Padding="18,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{loc:Tr Course.Hub.Path}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="{loc:Tr Course.Hub.Path.Text}" Style="{StaticResource Body}" FontSize="14" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- ============ Modules ============ -->
            <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type course:CourseModuleViewModel}">
                        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                            <DockPanel>
                                <!-- Gradient header -->
                                <Border DockPanel.Dock="Top" Background="{Binding HeroGradient}" CornerRadius="14,14,0,0" Padding="20,18,20,16">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="15" Background="{Binding AccentGradient}" VerticalAlignment="Top">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="{Binding AccentColor}" />
                                            </Border.Effect>
                                            <TextBlock Text="{Binding ModuleNumber}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold"
                                                       Foreground="#06101F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="14,0,0,0">
                                            <TextBlock Text="{Binding ModuleLabel}" FontSize="11" FontWeight="Bold" Foreground="{Binding AccentBrush}" />
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="17" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Button DockPanel.Dock="Bottom" Margin="20,8,20,18" HorizontalAlignment="Stretch" Padding="14,9"
                                        Background="{Binding AccentGradient}" BorderBrush="Transparent" Foreground="#06101F" FontWeight="SemiBold"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:Tr Course.Hub.StartModule}" />
                                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Margin="20,14,20,0">
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="13" LineHeight="19" />
                                    <TextBlock Text="{loc:Tr Course.Hub.Lessons}" Style="{StaticResource Caption}" Margin="0,14,0,6" />
                                    <ItemsControl ItemsSource="{Binding Lessons}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type course:LessonViewModel}">
                                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="8,7" Margin="-8,0,-8,1"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        ToolTip="{Binding Lead}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Width="34"
                                                                   Foreground="{Binding AccentBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ How to use ============ -->
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE82D;" Title="{loc:Tr Course.Hub.Tip1.Title}" />
                        <TextBlock Text="{loc:Tr Course.Hub.Tip1.Text}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE7BE;" Title="{loc:Tr Course.Hub.Tip2.Title}" />
                        <TextBlock Text="{loc:Tr Course.Hub.Tip2.Text}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE8F1;" Title="{loc:Tr Course.Hub.Tip3.Title}" />
                        <TextBlock Text="{loc:Tr Course.Hub.Tip3.Text}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

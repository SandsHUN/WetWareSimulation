<l:LessonView x:Class="WetWare.App.Views.Course.Lessons.MixtureLessonView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:l="clr-namespace:WetWare.App.Views.Course.Lessons"
              xmlns:loc="clr-namespace:WetWare.App.Localization"
              xmlns:c="clr-namespace:WetWare.App.Controls"
              xmlns:cc="clr-namespace:WetWare.App.Controls.Course"
              xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SectionHeader Glyph="&#xE9D5;" Title="{loc:Tr M7.Em.Algorithm}" Tip="{loc:Tr M7.Em.Algorithm.Tip}" />
                    <c:ParamSlider Label="{loc:Tr M7.Em.Count}" Tip="{loc:Tr M7.Em.Count.Tip}" Value="{Binding Count}" Minimum="1" Maximum="5" Step="1" Decimals="0" />
                    <Border Style="{StaticResource FormulaBox}" Margin="0,6,0,8">
                        <TextBlock Text="{Binding Phase}" Style="{StaticResource Body}" />
                    </Border>
                    <WrapPanel>
                        <Button Content="{loc:Tr M7.Em.HalfStep}" ToolTip="{loc:Tr M7.Em.HalfStep.Tip}" Command="{Binding HalfStepCommand}" Margin="0,0,6,6" />
                        <Button Content="{loc:Tr M7.Em.Iterate}" Command="{Binding IterateCommand}" Margin="0,0,6,6" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleRunCommand}" Margin="0,0,6,6">
                            <TextBlock Text="{loc:Tr Course.RunPause}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding ResetCommand}" ToolTip="{loc:Tr M7.Em.Reset.Tip}" Margin="0,0,6,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SectionHeader Glyph="&#xE81E;" Title="{loc:Tr M7.Competitive.Data}" />
                    <UniformGrid Columns="2">
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="EmLayout" Content="{loc:Tr M7.Layout.Overlapping}" IsChecked="{Binding Layout, Converter={StaticResource Choice}, ConverterParameter=Overlapping}" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="EmLayout" Content="{loc:Tr M7.Layout.TwoBlobs}" IsChecked="{Binding Layout, Converter={StaticResource Choice}, ConverterParameter=TwoBlobs}" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="EmLayout" Content="{loc:Tr M7.Layout.ThreeBlobs}" IsChecked="{Binding Layout, Converter={StaticResource Choice}, ConverterParameter=ThreeBlobs}" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="EmLayout" Content="{loc:Tr M7.Layout.Elongated}" IsChecked="{Binding Layout, Converter={StaticResource Choice}, ConverterParameter=Elongated}" />
                    </UniformGrid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SectionHeader Glyph="&#xE945;" Title="{loc:Tr M7.Em.Generate}" Tip="{loc:Tr M7.Em.Generate.Tip}" />
                    <TextBlock Text="{loc:Tr M7.Em.Generate.Text}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Content="{loc:Tr M7.Em.Dream}" Command="{Binding DreamCommand}" Margin="0,0,6,6" />
                        <Button Content="{loc:Tr Common.Clear}" Command="{Binding ClearDreamsCommand}" Margin="0,0,6,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SectionHeader Glyph="&#xE7B3;" Title="{loc:Tr M7.Em.Plane}" Tip="{loc:Tr M7.Em.Plane.Tip}" />
                    <cc:PlaneCanvas x:Name="Plane" Height="420" />
                    <TextBlock Text="{Binding Readout}" Style="{StaticResource Readout}" />
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE8EF;" Title="{loc:Tr M7.Em.Bayes}" Tip="{loc:Tr M7.Em.Bayes.Tip}" />
                        <sp:WpfPlot x:Name="BayesPlot" Height="200" />
                        <TextBlock Text="{Binding ProbeText}" Style="{StaticResource Readout}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SectionHeader Glyph="&#xE9D2;" Title="{loc:Tr M7.Em.Likelihood}" Tip="{loc:Tr M7.Em.Likelihood.Tip}" />
                        <sp:WpfPlot x:Name="LikelihoodPlot" Height="200" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</l:LessonView>
